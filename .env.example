# Email Service Configuration (Required for contact form)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email addresses (Optional - defaults are provided)
# The "from" address must be verified in your Resend account
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Where contact form submissions will be sent
CONTACT_EMAIL=hello@microgridfoundry.co.uk

# Debug page access control (Optional)
# Set to "false" to disable the debug page in production
ENABLE_DEBUG_PAGE=true
